// v0.2 multi-qubit gates

.visible .entry apply_swap(
    .param .u64 s,
    .param .u32 N,
    .param .u32 a,
    .param .u32 b
)
{    .reg .u64 %addr_i, %addr_j, %a64;
    .reg .u32 %gtid, %total, %one, %off, %i, %j;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .u64 %ptr;    .reg .u32 %n;    .reg .u32 %a;    .reg .u32 %b;    .reg .f32 %re_i, %im_i, %re_j, %im_j;
    .reg .pred %p;
    .reg .u32 %abit, %bbit;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %a, [a];
    ld.param.u32 %b, [b];
    mov.u32 %one, 1;
    shl.b32 %abit, %one, %a;
    shl.b32 %bbit, %one, %b;

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;
    and.b32 %off, %gtid, %abit;
    setp.eq.u32 %p, %off, %abit;
    @!%p bra $next;
    and.b32 %off, %gtid, %bbit;
    setp.eq.u32 %p, %off, 0;
    @!%p bra $next;
    mov.u32 %i, %gtid;
    mov.u32 %j, %i;
    xor.b32 %j, %j, %abit;
    xor.b32 %j, %j, %bbit;
    mul.wide.u32 %a64, %i, 8;
    add.u64 %addr_i, %ptr, %a64;
    mul.wide.u32 %a64, %j, 8;
    add.u64 %addr_j, %ptr, %a64;
    ld.global.f32 %re_i, [%addr_i];
    ld.global.f32 %im_i, [%addr_i+4];
    ld.global.f32 %re_j, [%addr_j];
    ld.global.f32 %im_j, [%addr_j+4];
    st.global.f32 [%addr_i], %re_j;
    st.global.f32 [%addr_i+4], %im_j;
    st.global.f32 [%addr_j], %re_i;
    st.global.f32 [%addr_j+4], %im_i;
    bra $next;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}


.visible .entry apply_iswap(
