// cooperative grid barrier (M4-P2 persistent kernel)
// Requires a cooperative launch (all blocks resident). Monotonic phase
// counter: barrier k expects phase == k after all blocks have arrived.
.global .align 4 .b32 g_bar_arrived;
.global .align 4 .b32 g_bar_phase;

// Grid-wide barrier. Every thread in every block must reach it exactly the
// same number of times, or the kernel deadlocks. Expected phase = the count
// of barriers already completed (1 for the first barrier).
.func grid_sync(.param .u32 phase)
{
    .reg .pred %p;
    .reg .u32 %tidr, %val, %nblk;
    .reg .u64 %addr;
    .reg .u32 %phase;

    ld.param.u32 %phase, [phase];
    mov.u32 %tidr, %tid.x;
    bar.sync 0;

    setp.ne.u32 %p, %tidr, 0;
    @%p bra $wait;

    // Block leader: arrive.
    mov.u64 %addr, g_bar_arrived;
    atom.add.u32 %val, [%addr], 1;
    mov.u32 %nblk, %nctaid.x;
    add.u32 %nblk, %nblk, -1;
    setp.eq.u32 %p, %val, %nblk;
    @!%p bra $wait;

    // Last block: reset the counter and release the phase.
    st.global.u32 [%addr], 0;
    membar.gl;
    mov.u64 %addr, g_bar_phase;
    st.global.u32 [%addr], %phase;
    membar.gl;
    bra $done;

$wait:
    // Spin (volatile so the store is always observed) until the phase.
    mov.u64 %addr, g_bar_phase;
$spin:
    ld.volatile.global.u32 %val, [%addr];
    setp.eq.u32 %p, %val, %phase;
    @!%p bra $spin;
    membar.gl;
$done:
    bar.sync 0;
    ret;
}

// barrier_bench: time N grid barriers over a real buffer.
// Not loaded by the Rust backend; kept for grid-barrier measurement only.
.visible .entry barrier_bench(
    .param .u64 s,
    .param .u32 N,
    .param .u32 iters
)
{
    .reg .pred %p;
    .reg .u32 %k, %iters, %phase, %n;
    .reg .u64 %ptr, %a64;
    .reg .f32 %one;
    .reg .u32 %gtid, %total, %oneu, %off;
    .reg .u32 %blk, %bdx, %tix, %gdx;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %iters, [iters];

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

    mov.f32 %one, 1.0;
    mov.u32 %oneu, 1;
    mov.u32 %k, 0;

$loop:
    setp.ge.u32 %p, %k, %iters;
    @%p bra $done;

    // touch one element per thread to give the barrier real work
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $sync;
    mul.wide.u32 %a64, %gtid, 8;
    add.u64 %a64, %ptr, %a64;
    st.global.f32 [%a64], %one;
$sync:
    add.u32 %phase, %k, 1;
    call grid_sync, (%phase);
    add.u32 %k, %k, 1;
    bra $loop;
$done:
    ret;
}



// shared-memory mega-kernel gate funcs
.func g_h(
    .param .u32 i,
    .param .u32 q0,
    .param .u64 p
)
{    .reg .pred %pp;
    .reg .u32 %bit, %j;
    .reg .u64 %ai, %aj;
    .reg .f32 %ri, %ii, %rj, %ij, %nri, %nii, %nrj, %nij, %t0, %u0, %v0, %w0;
    .reg .u32 %i;    .reg .u32 %q0;    .reg .u64 %p;
    ld.param.u32 %i, [i];
    ld.param.u32 %q0, [q0];
    ld.param.u64 %p, [p];
    mov.u32 %bit, 1;
    shl.b32 %bit, %bit, %q0;
    and.b32 %bit, %i, %bit;
    setp.ne.u32 %pp, %bit, 0;
    @%pp ret;
    mov.u32 %bit, 1;
    shl.b32 %bit, %bit, %q0;
    or.b32 %j, %i, %bit;
    mul.wide.u32 %ai, %i, 8;
    add.u64 %ai, %p, %ai;
    mul.wide.u32 %aj, %j, 8;
    add.u64 %aj, %p, %aj;
    ld.shared.f32 %ri, [%ai];
    ld.shared.f32 %ii, [%ai+4];
    ld.shared.f32 %rj, [%aj];
    ld.shared.f32 %ij, [%aj+4];

    mov.f32 %t0, 0.70710678;
    add.f32 %u0, %ri, %rj; mul.f32 %nri, %u0, %t0;
    add.f32 %u0, %ii, %ij; mul.f32 %nii, %u0, %t0;
    sub.f32 %u0, %ri, %rj; mul.f32 %nrj, %u0, %t0;
    sub.f32 %u0, %ii, %ij; mul.f32 %nij, %u0, %t0;
    st.shared.f32 [%ai], %nri;
    st.shared.f32 [%ai+4], %nii;
    st.shared.f32 [%aj], %nrj;
    st.shared.f32 [%aj+4], %nij;
}


.func g_x(
    .param .u32 i,
    .param .u32 q0,
    .param .u64 p
)
{    .reg .pred %pp;
    .reg .u32 %bit, %j;
    .reg .u64 %ai, %aj;
    .reg .f32 %ri, %ii, %rj, %ij, %nri, %nii, %nrj, %nij, %t0, %u0, %v0, %w0;
    .reg .u32 %i;    .reg .u32 %q0;    .reg .u64 %p;
    ld.param.u32 %i, [i];
    ld.param.u32 %q0, [q0];
    ld.param.u64 %p, [p];
    mov.u32 %bit, 1;
    shl.b32 %bit, %bit, %q0;
    and.b32 %bit, %i, %bit;
    setp.ne.u32 %pp, %bit, 0;
    @%pp ret;
    mov.u32 %bit, 1;
    shl.b32 %bit, %bit, %q0;
    or.b32 %j, %i, %bit;
    mul.wide.u32 %ai, %i, 8;
    add.u64 %ai, %p, %ai;
    mul.wide.u32 %aj, %j, 8;
    add.u64 %aj, %p, %aj;
    ld.shared.f32 %ri, [%ai];
    ld.shared.f32 %ii, [%ai+4];
    ld.shared.f32 %rj, [%aj];
    ld.shared.f32 %ij, [%aj+4];
    mov.f32 %nri, %rj; mov.f32 %nii, %ij;
    mov.f32 %nrj, %ri; mov.f32 %nij, %ii;
    st.shared.f32 [%ai], %nri;
    st.shared.f32 [%ai+4], %nii;
    st.shared.f32 [%aj], %nrj;
    st.shared.f32 [%aj+4], %nij;
}


.func g_cnot(
    .param .u32 i,
    .param .u32 q0,
    .param .u32 q1,
    .param .u64 p
)
{    .reg .pred %pp;
    .reg .u32 %bit, %j;
    .reg .u64 %ai, %aj;
    .reg .f32 %ri, %ii, %rj, %ij, %nri, %nii, %nrj, %nij, %t0, %u0, %v0, %w0;
    .reg .u32 %cbit, %tbit;
    .reg .u32 %i;    .reg .u32 %q0;    .reg .u32 %q1;    .reg .u64 %p;
    ld.param.u32 %i, [i];
    ld.param.u32 %q0, [q0];
    ld.param.u32 %q1, [q1];
    ld.param.u64 %p, [p];
    mov.u32 %tbit, 1; shl.b32 %tbit, %tbit, %q1;
    and.b32 %tbit, %i, %tbit; setp.ne.u32 %pp, %tbit, 0; @%pp ret;
    mov.u32 %cbit, 1; shl.b32 %cbit, %cbit, %q0;
    and.b32 %cbit, %i, %cbit; setp.eq.u32 %pp, %cbit, 0; @%pp ret;
    mov.u32 %bit, 1; shl.b32 %bit, %bit, %q1;
