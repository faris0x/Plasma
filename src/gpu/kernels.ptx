    sub.f32 %x, %re_i, %im_i;
    add.f32 %y, %re_j, %im_j;
    add.f32 %x, %x, %y;
    mul.f32 %nr, %x, %t;
    add.f32 %x, %re_i, %im_i;
    sub.f32 %y, %im_j, %re_j;
    add.f32 %x, %x, %y;
    mul.f32 %ni, %x, %t;
