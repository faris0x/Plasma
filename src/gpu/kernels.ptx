.visible .entry apply_cphase(
    .param .u64 s,
    .param .u32 N,
    .param .u32 a,
    .param .u32 b,
    .param .f32 c,
    .param .f32 sn
)
{    .reg .u64 %addr_i, %addr_j, %a64;
    .reg .u32 %gtid, %total, %one, %off, %i, %j;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .u64 %ptr;    .reg .u32 %n;    .reg .u32 %a;    .reg .u32 %b;    .reg .f32 %c;    .reg .f32 %sn;    .reg .f32 %re_i, %im_i, %nr, %ni, %t;
    .reg .pred %p;
    .reg .u32 %amask;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %a, [a];
    ld.param.u32 %b, [b];
    ld.param.f32 %c, [c];
    ld.param.f32 %sn, [sn];
    mov.u32 %one, 1;
    shl.b32 %amask, %one, %a;
    shl.b32 %off, %one, %b;
    or.b32 %amask, %amask, %off;

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;
    and.b32 %off, %gtid, %amask;
    setp.eq.u32 %p, %off, %amask;
    @!%p bra $next;
    mul.wide.u32 %a64, %gtid, 8;
    add.u64 %addr_i, %ptr, %a64;
    ld.global.f32 %re_i, [%addr_i];
    ld.global.f32 %im_i, [%addr_i+4];
    mul.f32 %nr, %re_i, %c;
    mul.f32 %t, %im_i, %sn;
    sub.f32 %nr, %nr, %t;
    mul.f32 %ni, %re_i, %sn;
    mul.f32 %t, %im_i, %c;
    add.f32 %ni, %ni, %t;
    st.global.f32 [%addr_i], %nr;
    st.global.f32 [%addr_i+4], %ni;
    bra $next;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}


