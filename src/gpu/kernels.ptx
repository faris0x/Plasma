    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;
    and.b32 %off, %gtid, %abit;
    setp.eq.u32 %p, %off, %abit;
    @!%p bra $next;
    and.b32 %off, %gtid, %bbit;
    setp.eq.u32 %p, %off, 0;
    @!%p bra $next;
    mov.u32 %i, %gtid;
