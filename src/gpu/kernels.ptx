    ld.global.f32 %im_i, [%addr_i+4];
    ld.global.f32 %re_j, [%addr_j];
    ld.global.f32 %im_j, [%addr_j+4];

    mov.f32 %t, 0.70710678;
    mul.f32 %x, %re_j, %t;
    mul.f32 %y, %im_j, %t;
    sub.f32 %nr, %x, %y;
    add.f32 %ni, %x, %y;
    st.global.f32 [%addr_j], %nr;
    st.global.f32 [%addr_j+4], %ni;
    bra $next;
$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
