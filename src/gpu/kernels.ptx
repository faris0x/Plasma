//
// Plasma GPU kernel library.
//
// Statevector layout: N = 2^n complex amplitudes, interleaved float2:
//   index i -> s[2i]   = real part
//   index i -> s[2i+1] = imaginary part
//
// Loaded through the CUDA driver API (cuModuleLoadData). The driver's
// PTX JIT (libnvidia-ptxjitcompiler) compiles this to SASS for the actual
// GPU, so no CUDA C, no nvcc, and no toolkit ships on the target.
//
// All kernels are 1-D grid-stride loops, one thread per index i.
// PTX special registers (%tid.x etc.) are moved into regular registers
// before arithmetic, per the PTX ISA rules.
//

.version 8.6
.target sm_80
.address_size 64

// Dynamic shared memory for the mega kernel.
.extern .shared .align 4 .b32 smem[];

// Deterministic-reduction scratch: each block stores its per-thread partials
// (256 threads) and thread 0 sums them in thread-index order.
.shared .align 4 .b32 sdata_prob[512];
.shared .align 4 .b32 sdata_final[256];

// reset: |0..0>
.visible .entry reset(
    .param .u64 s,
    .param .u32 N
)
{
    .reg .u64 %ptr, %addr, %a64;
    .reg .u32 %n, %gtid, %total, %off;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .f32 %one, %zero;
    .reg .pred %p;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

    mov.f32 %one, 1.0;
    mov.f32 %zero, 0.0;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;

    mul.wide.u32 %a64, %gtid, 8;
    add.u64 %addr, %ptr, %a64;

    setp.eq.u32 %p, %gtid, 0;
    @%p bra $is0;
    st.global.f32 [%addr], %zero;
    st.global.f32 [%addr+4], %zero;
    bra $next;
$is0:
    st.global.f32 [%addr], %one;
    st.global.f32 [%addr+4], %zero;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}

// apply_h: Hadamard butterfly on qubit q
.visible .entry apply_h(
    .param .u64 s,
    .param .u32 N,
    .param .u32 q
)
{
    .reg .u64 %ptr, %addr_i, %addr_j, %a64;
    .reg .u32 %n, %gtid, %total, %bit, %q, %one, %off, %i, %j;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .f32 %re_i, %im_i, %re_j, %im_j;
    .reg .f32 %nr_i, %ni_i, %nr_j, %ni_j;
    .reg .f32 %inv;
    .reg .pred %p;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %q, [q];

    mov.u32 %one, 1;
    shl.b32 %bit, %one, %q;
    mov.f32 %inv, 0.7071067811865476;

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;

    and.b32 %off, %gtid, %bit;
    setp.eq.u32 %p, %off, 0;
    @!%p bra $next;              // high member: handled by its partner

    mov.u32 %i, %gtid;
    or.b32 %j, %i, %bit;

    mul.wide.u32 %a64, %i, 8;
    add.u64 %addr_i, %ptr, %a64;
    mul.wide.u32 %a64, %j, 8;
    add.u64 %addr_j, %ptr, %a64;

    ld.global.f32 %re_i, [%addr_i];
    ld.global.f32 %im_i, [%addr_i+4];
    ld.global.f32 %re_j, [%addr_j];
    ld.global.f32 %im_j, [%addr_j+4];

    add.f32 %nr_i, %re_i, %re_j;
    mul.f32 %nr_i, %nr_i, %inv;
    add.f32 %ni_i, %im_i, %im_j;
    mul.f32 %ni_i, %ni_i, %inv;
    sub.f32 %nr_j, %re_i, %re_j;
    mul.f32 %nr_j, %nr_j, %inv;
    sub.f32 %ni_j, %im_i, %im_j;
    mul.f32 %ni_j, %ni_j, %inv;

    st.global.f32 [%addr_i], %nr_i;
    st.global.f32 [%addr_i+4], %ni_i;
    st.global.f32 [%addr_j], %nr_j;
    st.global.f32 [%addr_j+4], %ni_j;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}

// apply_x: swap amplitude pairs on qubit q
.visible .entry apply_x(
    .param .u64 s,
    .param .u32 N,
    .param .u32 q
)
{
    .reg .u64 %ptr, %addr_i, %addr_j, %a64;
    .reg .u32 %n, %gtid, %total, %bit, %q, %one, %off, %i, %j;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .f32 %re_i, %im_i, %re_j, %im_j;
    .reg .pred %p;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %q, [q];

    mov.u32 %one, 1;
    shl.b32 %bit, %one, %q;

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;

    and.b32 %off, %gtid, %bit;
    setp.eq.u32 %p, %off, 0;
    @!%p bra $next;

    mov.u32 %i, %gtid;
    or.b32 %j, %i, %bit;

    mul.wide.u32 %a64, %i, 8;
    add.u64 %addr_i, %ptr, %a64;
    mul.wide.u32 %a64, %j, 8;
    add.u64 %addr_j, %ptr, %a64;

    ld.global.f32 %re_i, [%addr_i];
    ld.global.f32 %im_i, [%addr_i+4];
    ld.global.f32 %re_j, [%addr_j];
    ld.global.f32 %im_j, [%addr_j+4];

    st.global.f32 [%addr_i], %re_j;
    st.global.f32 [%addr_i+4], %im_j;
    st.global.f32 [%addr_j], %re_i;
    st.global.f32 [%addr_j+4], %im_i;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}

// apply_cnot: swap pairs on target t when control c is set
.visible .entry apply_cnot(
    .param .u64 s,
    .param .u32 N,
    .param .u32 c,
    .param .u32 t
)
{
    .reg .u64 %ptr, %addr_i, %addr_j, %a64;
    .reg .u32 %n, %gtid, %total, %cbit, %tbit, %one, %off, %i, %j;
    .reg .u32 %c, %t;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .f32 %re_i, %im_i, %re_j, %im_j;
    .reg .pred %p;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %c, [c];
    ld.param.u32 %t, [t];

    mov.u32 %one, 1;
    shl.b32 %cbit, %one, %c;
    mov.u32 %one, 1;
    shl.b32 %tbit, %one, %t;

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;

    and.b32 %off, %gtid, %tbit;
    setp.eq.u32 %p, %off, 0;
    @!%p bra $next;

    mov.u32 %i, %gtid;
    and.b32 %off, %i, %cbit;
    setp.eq.u32 %p, %off, %cbit;
    @!%p bra $next;

    or.b32 %j, %i, %tbit;

    mul.wide.u32 %a64, %i, 8;
    add.u64 %addr_i, %ptr, %a64;
    mul.wide.u32 %a64, %j, 8;
    add.u64 %addr_j, %ptr, %a64;

    ld.global.f32 %re_i, [%addr_i];
    ld.global.f32 %im_i, [%addr_i+4];
    ld.global.f32 %re_j, [%addr_j];
    ld.global.f32 %im_j, [%addr_j+4];

    st.global.f32 [%addr_i], %re_j;
    st.global.f32 [%addr_i+4], %im_j;
    st.global.f32 [%addr_j], %re_i;
    st.global.f32 [%addr_j+4], %im_i;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}

// apply_toff: swap pairs on target t when c1 and c2 are set
.visible .entry apply_toff(
    .param .u64 s,
    .param .u32 N,
    .param .u32 c1,
    .param .u32 c2,
    .param .u32 t
)
{
    .reg .u64 %ptr, %addr_i, %addr_j, %a64;
    .reg .u32 %n, %gtid, %total, %c1bit, %c2bit, %tbit, %one, %off, %i, %j;
    .reg .u32 %c1, %c2, %t;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .f32 %re_i, %im_i, %re_j, %im_j;
    .reg .pred %p;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %c1, [c1];
    ld.param.u32 %c2, [c2];
    ld.param.u32 %t, [t];

    mov.u32 %one, 1;
    shl.b32 %c1bit, %one, %c1;
    mov.u32 %one, 1;
    shl.b32 %c2bit, %one, %c2;
    mov.u32 %one, 1;
    shl.b32 %tbit, %one, %t;

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;

    and.b32 %off, %gtid, %tbit;
    setp.eq.u32 %p, %off, 0;
    @!%p bra $next;

    mov.u32 %i, %gtid;
    and.b32 %off, %i, %c1bit;
    setp.eq.u32 %p, %off, %c1bit;
    @!%p bra $next;
    and.b32 %off, %i, %c2bit;
    setp.eq.u32 %p, %off, %c2bit;
    @!%p bra $next;

    or.b32 %j, %i, %tbit;

    mul.wide.u32 %a64, %i, 8;
    add.u64 %addr_i, %ptr, %a64;
    mul.wide.u32 %a64, %j, 8;
    add.u64 %addr_j, %ptr, %a64;

    ld.global.f32 %re_i, [%addr_i];
    ld.global.f32 %im_i, [%addr_i+4];
    ld.global.f32 %re_j, [%addr_j];
    ld.global.f32 %im_j, [%addr_j+4];

    st.global.f32 [%addr_i], %re_j;
    st.global.f32 [%addr_i+4], %im_j;
    st.global.f32 [%addr_j], %re_i;
    st.global.f32 [%addr_j+4], %im_i;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}

// prob_partial: per-block partial sums of P(qubit q = 1)
// Deterministic two-stage reduction with COMPENSATED (Kahan/Neumaier)
// summation: each thread accumulates its |amp|^2 terms into a (hi, lo) pair,
// thread 0 re-accumulates the block's pairs in thread-index order, and each
// block writes its (hi, lo) partial to scratch[2*b]/scratch[2*b+1].
// Compensation removes the O(sqrt(n)) f32 summation drift, which would
// otherwise be ~1e-3 relative on 2^28-term sums.
.visible .entry prob_partial(
    .param .u64 s,
    .param .u32 N,
    .param .u32 q,
    .param .u64 scratch
)
{
    .reg .u64 %ptr, %scrptr, %addr, %a64, %saddr, %sbase;
    .reg .u32 %n, %gtid, %total, %bit, %q, %one, %off;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .f32 %re, %im, %tmp, %chi, %clo, %y, %sum;
    .reg .pred %p;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %q, [q];
    ld.param.u64 %scrptr, [scratch];

    mov.u32 %one, 1;
    shl.b32 %bit, %one, %q;

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

    mov.f32 %chi, 0.0;
    mov.f32 %clo, 0.0;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $reduce;

    and.b32 %off, %gtid, %bit;
    setp.eq.u32 %p, %off, 0;
    @%p bra $next;

    mul.wide.u32 %a64, %gtid, 8;
    add.u64 %addr, %ptr, %a64;
    ld.global.f32 %re, [%addr];
    ld.global.f32 %im, [%addr+4];
    mul.f32 %tmp, %re, %re;
    mul.f32 %im, %im, %im;
    add.f32 %tmp, %tmp, %im;
    // Kahan: y = t - clo; sum = chi + y; clo = (sum - chi) - y; chi = sum
    sub.f32 %y, %tmp, %clo;
    add.f32 %sum, %chi, %y;
    sub.f32 %clo, %sum, %chi;
    sub.f32 %clo, %clo, %y;
    mov.f32 %chi, %sum;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;

$reduce:
    mov.u64 %sbase, sdata_prob;
    mul.wide.u32 %a64, %tix, 8;
    add.u64 %saddr, %sbase, %a64;
    st.shared.f32 [%saddr], %chi;
    st.shared.f32 [%saddr+4], %clo;
    bar.sync 0;

    setp.ne.u32 %p, %tix, 0;
    @%p bra $done;

    // Thread 0 Kahan-sums the 2*bdx (hi, lo) values in index order.
    mov.f32 %chi, 0.0;
    mov.f32 %clo, 0.0;
    mov.u32 %off, 0;
$bsum:
    setp.ge.u32 %p, %off, %bdx;
    @%p bra $write;
    mul.wide.u32 %a64, %off, 8;
    add.u64 %saddr, %sbase, %a64;
    ld.shared.f32 %tmp, [%saddr];
    sub.f32 %y, %tmp, %clo;
    add.f32 %sum, %chi, %y;
    sub.f32 %clo, %sum, %chi;
    sub.f32 %clo, %clo, %y;
    mov.f32 %chi, %sum;
    ld.shared.f32 %tmp, [%saddr+4];
    sub.f32 %y, %tmp, %clo;
    add.f32 %sum, %chi, %y;
    sub.f32 %clo, %sum, %chi;
    sub.f32 %clo, %clo, %y;
    mov.f32 %chi, %sum;
    add.u32 %off, %off, 1;
    bra $bsum;

$write:
    mul.wide.u32 %a64, %blk, 8;
    add.u64 %addr, %scrptr, %a64;
    st.global.f32 [%addr], %chi;
    st.global.f32 [%addr+4], %clo;
$done:
    ret;
}

// prob_finalize: deterministic Kahan sum of block (hi, lo) partials
.visible .entry prob_finalize(
    .param .u64 scratch,
    .param .u32 nblocks,
    .param .u64 out
)
{
    .reg .u64 %scrptr, %outptr, %addr, %a64, %saddr, %sbase;
    .reg .u32 %nblk, %tidr, %bdx, %chunk, %start, %end, %off;
    .reg .f32 %chi, %clo, %tmp, %y, %sum;
    .reg .pred %p;

    ld.param.u64 %scrptr, [scratch];
    ld.param.u32 %nblk, [nblocks];
    ld.param.u64 %outptr, [out];

    mov.u32 %tidr, %tid.x;
    mov.u32 %bdx, %ntid.x;

    mov.u32 %chunk, %nblk;
    add.u32 %chunk, %chunk, 255;
    shr.u32 %chunk, %chunk, 8;

    mul.lo.u32 %start, %tidr, %chunk;
    mov.u32 %end, %start;
    add.u32 %end, %end, %chunk;
    setp.ge.u32 %p, %end, %nblk;
    @%p mov.u32 %end, %nblk;

    mov.f32 %chi, 0.0;
    mov.f32 %clo, 0.0;
    mov.u32 %off, %start;
$loop:
    setp.ge.u32 %p, %off, %end;
    @%p bra $reduce;
    mul.wide.u32 %a64, %off, 8;
    add.u64 %addr, %scrptr, %a64;
    ld.global.f32 %tmp, [%addr];
    sub.f32 %y, %tmp, %clo;
    add.f32 %sum, %chi, %y;
    sub.f32 %clo, %sum, %chi;
    sub.f32 %clo, %clo, %y;
    mov.f32 %chi, %sum;
    ld.global.f32 %tmp, [%addr+4];
    sub.f32 %y, %tmp, %clo;
    add.f32 %sum, %chi, %y;
    sub.f32 %clo, %sum, %chi;
    sub.f32 %clo, %clo, %y;
    mov.f32 %chi, %sum;
    add.u32 %off, %off, 1;
    bra $loop;

$reduce:
    mov.u64 %sbase, sdata_prob;
    mul.wide.u32 %a64, %tidr, 8;
    add.u64 %saddr, %sbase, %a64;
    st.shared.f32 [%saddr], %chi;
    st.shared.f32 [%saddr+4], %clo;
    bar.sync 0;
    setp.ne.u32 %p, %tidr, 0;
    @%p bra $done;
    mov.f32 %chi, 0.0;
    mov.f32 %clo, 0.0;
    mov.u32 %off, 0;
$bsum:
    setp.ge.u32 %p, %off, %bdx;
    @%p bra $write;
    mul.wide.u32 %a64, %off, 8;
    add.u64 %saddr, %sbase, %a64;
    ld.shared.f32 %tmp, [%saddr];
    sub.f32 %y, %tmp, %clo;
    add.f32 %sum, %chi, %y;
    sub.f32 %clo, %sum, %chi;
    sub.f32 %clo, %clo, %y;
    mov.f32 %chi, %sum;
    ld.shared.f32 %tmp, [%saddr+4];
    sub.f32 %y, %tmp, %clo;
    add.f32 %sum, %chi, %y;
    sub.f32 %clo, %sum, %chi;
    sub.f32 %clo, %clo, %y;
    mov.f32 %chi, %sum;
    add.u32 %off, %off, 1;
    bra $bsum;

$write:
    add.f32 %tmp, %chi, %clo;
    st.global.f32 [%outptr], %tmp;
$done:
    ret;
}

// collapse: keep branch `outcome`, renormalise by inv_norm
.visible .entry collapse(
    .param .u64 s,
    .param .u32 N,
    .param .u32 q,
    .param .u32 outcome,
    .param .f32 inv_norm
)
{
    .reg .u64 %ptr, %addr, %a64;
    .reg .u32 %n, %gtid, %total, %q, %one, %outcome, %off;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .f32 %re, %im, %zero, %inv;
    .reg .pred %p;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %q, [q];
    ld.param.u32 %outcome, [outcome];
    ld.param.f32 %inv, [inv_norm];

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

    mov.f32 %zero, 0.0;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;

    mul.wide.u32 %a64, %gtid, 8;
    add.u64 %addr, %ptr, %a64;

    shr.u32 %off, %gtid, %q;
    and.b32 %off, %off, 1;
    setp.eq.u32 %p, %off, %outcome;
    @!%p bra $zero;

    ld.global.f32 %re, [%addr];
    ld.global.f32 %im, [%addr+4];
    mul.f32 %re, %re, %inv;
    mul.f32 %im, %im, %inv;
    st.global.f32 [%addr], %re;
    st.global.f32 [%addr+4], %im;
    bra $next;

$zero:
    st.global.f32 [%addr], %zero;
    st.global.f32 [%addr+4], %zero;

$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}



// v0.2 single-qubit rotation / phase kernels
// Angles are precomputed on the host (deterministic sin_cos) and passed
// as f32 params, so the GPU never needs its own trig.

.visible .entry apply_rz(
    .param .u64 s,
    .param .u32 N,
    .param .u32 q,
    .param .f32 cs,
    .param .f32 sn
)
{    .reg .u64 %addr_i, %addr_j, %a64;
    .reg .u32 %gtid, %total, %one, %off, %i, %j;
    .reg .u32 %blk, %bdx, %tix, %gdx;
    .reg .u64 %ptr;    .reg .u32 %n;    .reg .u32 %q;    .reg .f32 %cs;    .reg .f32 %sn;    .reg .f32 %re_i, %im_i, %re_j, %im_j, %nr, %ni, %t;
    .reg .pred %p;

    ld.param.u64 %ptr, [s];
    ld.param.u32 %n, [N];
    ld.param.u32 %q, [q];
    ld.param.f32 %cs, [cs];
    ld.param.f32 %sn, [sn];

    mov.u32 %one, 1;

    mov.u32 %blk, %ctaid.x;
    mov.u32 %bdx, %ntid.x;
    mov.u32 %tix, %tid.x;
    mov.u32 %gdx, %nctaid.x;
    mov.u32 %gtid, %blk;
    mad.lo.u32 %gtid, %gtid, %bdx, %tix;
    mov.u32 %total, %gdx;
    mul.lo.u32 %total, %total, %bdx;

$loop:
    setp.ge.u32 %p, %gtid, %n;
    @%p bra $done;
    shl.b32 %off, %one, %q;
    and.b32 %off, %gtid, %off;
    setp.eq.u32 %p, %off, 0;
    @!%p bra $next;
    mov.u32 %i, %gtid;
    shl.b32 %off, %one, %q;
    or.b32 %j, %i, %off;

    mul.wide.u32 %a64, %i, 8;
    add.u64 %addr_i, %ptr, %a64;
    mul.wide.u32 %a64, %j, 8;
    add.u64 %addr_j, %ptr, %a64;

    ld.global.f32 %re_i, [%addr_i];
    ld.global.f32 %im_i, [%addr_i+4];
    ld.global.f32 %re_j, [%addr_j];
    ld.global.f32 %im_j, [%addr_j+4];

    mul.f32 %nr, %re_i, %cs;
    mul.f32 %t, %im_i, %sn;
    add.f32 %nr, %nr, %t;
    mul.f32 %ni, %im_i, %cs;
    mul.f32 %t, %re_i, %sn;
    sub.f32 %ni, %ni, %t;
    st.global.f32 [%addr_i], %nr;
    st.global.f32 [%addr_i+4], %ni;

    mul.f32 %nr, %re_j, %cs;
    mul.f32 %t, %im_j, %sn;
    sub.f32 %nr, %nr, %t;
    mul.f32 %ni, %im_j, %cs;
    mul.f32 %t, %re_j, %sn;
    add.f32 %ni, %ni, %t;
    st.global.f32 [%addr_j], %nr;
    st.global.f32 [%addr_j+4], %ni;
    bra $next;
$next:
    add.u32 %gtid, %gtid, %total;
    bra $loop;
$done:
    ret;
}


